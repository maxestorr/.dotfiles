{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "apiKeyHelper": "~/.claude/generate_api_key.sh",
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(aws s3 ls:*)",
      "Bash(aws s3api get-object:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git blame:*)"
    ],
    "defaultMode": "default"
  },
  "model": "claude-opus-4-6[1m]",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-4-6": {
      "effortLevel": "high"
    }
  },
  "tui": "default",
  "verbose": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754056869496
  },
  "feedbackDrafts": "off"
}
